{
  "name": "bkn-cat-browser",
  "version": "1.3.2",
  "description": "Secure exam browser for BKN CAT — SMA Unggul Binakasih Nusantara",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac-arm64": "electron-builder --mac --arm64",
    "build:mac-x64": "electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.binakasih.bkn-cat",
    "productName": "BKN CAT",
    "copyright": "© 2024 SMA Unggul Binakasih Nusantara",
    "asar": true,
    "files": [
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "dmg", "arch": ["x64"] }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "BKN CAT Browser",
      "background": null,
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "BKN-CAT-Windows.exe"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
